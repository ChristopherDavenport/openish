{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    /*
     * The Playwright provider is what fills in `CDPSession`, which vitest declares empty for
     * providers to augment. `forced-colors.test.ts` sends a CDP command, and without this the
     * session has no `send`.
     */
    "types": ["vite/client", "@vitest/browser-playwright"],
    "paths": {
      "@openish/core": ["../core/src/index.ts"]
    }
  },
  "include": ["test/**/*.ts"]
}
