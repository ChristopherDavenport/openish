{
  "name": "@openish/elements",
  "version": "0.0.0",
  "description": "Lit web components for rendering OpenAPI reference documentation",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./standalone": {
      "types": "./dist/standalone.d.ts",
      "import": "./dist/standalone.js",
      "default": "./dist/standalone.js"
    }
  },
  "files": [
    "dist",
    "custom-elements.json",
    "README.md"
  ],
  "sideEffects": [
    "./dist/**/*.js",
    "./src/**/*.ts"
  ],
  "scripts": {
    "build": "tsc -b && npm run docs && node ../../scripts/build-standalone.mjs",
    "clean": "rm -rf dist tsconfig.tsbuildinfo custom-elements.json",
    "docs": "cem analyze --litelement --globs \"src/**/*.ts\" --outdir . && node ../../scripts/docs-elements.mjs"
  },
  "dependencies": {
    "@lit-labs/virtualizer": "^2.1.1",
    "@lit/context": "^1.1.6",
    "@lit/task": "^1.0.3",
    "@openish/client": "0.0.0",
    "@openish/core": "0.0.0",
    "@openish/theme": "0.0.0",
    "@scalar/code-highlight": "^0.4.3",
    "lit": "^3.3.3"
  },
  "customElements": "custom-elements.json"
}
