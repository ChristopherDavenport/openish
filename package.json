{
  "name": "openish",
  "private": true,
  "type": "module",
  "description": "Lit web components for viewing OpenAPI documents, built on Scalar's framework-agnostic core",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @openish/playground",
    "dev:site": "npm run dev -w @openish/site",
    "build": "npm run build -ws --if-present",
    "clean": "rm -rf packages/*/dist apps/*/dist packages/*/tsconfig.tsbuildinfo",
    "typecheck": "tsc -b && tsc -p packages/elements/tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "guard": "npm run guard:backticks && npm run guard:vue && npm run guard:specs && npm run guard:focus && npm run guard:templates",
    "guard:backticks": "node scripts/guard-template-backticks.mjs",
    "guard:vue": "node scripts/guard-no-vue.mjs",
    "guard:specs": "node scripts/guard-no-specs.mjs",
    "guard:focus": "node scripts/guard-focus.mjs",
    "guard:templates": "node scripts/guard-templates.mjs",
    "verify": "npm run guard && npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@jack-henry/jh-core": "^1.6.1",
    "@jack-henry/jh-icons": "^2.0.0",
    "@jack-henry/jh-ui": "^1.15.5",
    "@types/node": "^24.13.3",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "axe-core": "^4.12.1",
    "esbuild": "^0.28.1",
    "lit-analyzer": "^2.0.3",
    "playwright": "^1.62.1",
    "typescript": "~5.9.3",
    "vite": "^7.1.9",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "lit": "^3.3.3"
  }
}
