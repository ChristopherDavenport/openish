{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],
    "paths": {
      "@openish/core": ["../../packages/core/src/index.ts"],
      "@openish/client": ["../../packages/client/src/index.ts"],
      "@openish/elements": ["../../packages/elements/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "vite.config.ts"]
}
